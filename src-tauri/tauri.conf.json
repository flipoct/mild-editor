{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mild Editor",
  "version": "1.0.0",
  "identifier": "io.mildeditor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mild Editor",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
